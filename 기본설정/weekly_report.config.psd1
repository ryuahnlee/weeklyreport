# 처음설정.cmd가 만드는 개인 설정의 예시입니다. 실제 설정은 Git에 올리지 마세요.
@{
    EMAIL = 'you@example.com'
    TOKEN = 'YOUR_API_TOKEN'
    NAME = '본인 이름'
    DOMAIN = 'https://your-team.atlassian.net'
    FOLDER_ID = '123456789'
    SPACE_KEY = '~your-space-key'
