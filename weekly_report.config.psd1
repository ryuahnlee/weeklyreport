# 대괄호 [...] 부분을 본인 정보로 바꾸세요. 작은따옴표는 그대로 둡니다.
# UTF-8 BOM으로 저장하세요. 입력을 마친 파일은 다른 사람에게 보내거나 GitHub에 올리지 마세요.
@{
    EMAIL = '[본인 Jira 로그인 이메일]'
    TOKEN = '[본인 API 토큰]'
    NAME = '[보고서에 표시할 본인 이름]'
    DOMAIN = '[회사 Atlassian 주소: https://회사명.atlassian.net]'
    FOLDER_ID = '[보고서를 저장할 폴더 또는 상위 페이지의 숫자 ID]'
    SPACE_KEY = '[Confluence 스페이스 키]'
    # 선택 항목입니다. 비워 두면 Jira 이슈를 링크로 표시합니다.
    SERVER_ID = ''
}
